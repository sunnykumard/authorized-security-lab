# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Local evidence may contain sensitive material; keep only templates tracked
/evidence/screenshots/*
!/evidence/screenshots/.gitkeep
/evidence/logs/*
!/evidence/logs/.gitkeep
/evidence/configurations/*
!/evidence/configurations/.gitkeep
/evidence/network/*
!/evidence/network/.gitkeep
/evidence/reports/*
!/evidence/reports/.gitkeep

# Local/editor/OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
